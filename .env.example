# Copy to .env (never commit .env). Read by docker-compose.yml.

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command (the long string after --token).
TUNNEL_TOKEN=

# Most build jobs the whole site starts per 24 hours. Keep it low for the friends beta.
DAILY_JOB_LIMIT=100
# Running jobs one visitor can have at once.
MAX_ACTIVE_JOBS_PER_CLIENT=2
# Jobs run side by side. A guide uses up to 4 cores, so 2 workers is about 8 cores at full load.
JOB_WORKERS=2
# CPU cores the app container may use.
APP_CPUS=8
